[user]
	name = Jared McFarland
	email = jared.online@gmail.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[beads]
	role = maintainer
[core]
	fsmonitor = false
# figma-org HTTPS→SSH rewrite is conditionally installed by
# figma/dotfiles/users/jmcfarland/install.sh into the file below.
# Present on local macOS, absent on Coder workspaces (where coder gitssh
# can't authenticate to GitHub with the workspace key).
[include]
	path = ~/.config/git/figma.conf
